# .env.example

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=crypto_analyzer
DB_USER=postgres
DB_PASSWORD=your_password_here

# --- Telegram (опционально) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# --- Источник данных ---
# Допустимые значения: okx | binance
DATA_SOURCE=okx

# --- Приложение ---
INTERVAL=1H
UPDATE_INTERVAL_HOURS=1